{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "local app debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/helloworld_c",
            "program": "${workspaceFolder}/build/helloworld_c/app",
            "MIMode": "gdb",
            "args": []
        },
        {
            "name": "target app debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default",
            "program": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default/app.elf",
            "preLaunchTask": "target app reset",
            "args": [],
            "environment": [],
            "externalConsole": false,
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "MIMode": "gdb",
            "targetArchitecture": "arm",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:2331",
            "miDebuggerArgs": "-q -x \"gdb_init.gdb\""
        },
        {
            "name": "target app debug (load)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default",
            "program": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default/app.elf",
            "preLaunchTask": "target app load",
            "args": [],
            "environment": [],
            "externalConsole": false,
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "MIMode": "gdb",
            "targetArchitecture": "arm",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:2331",
            "miDebuggerArgs": "-q -x \"gdb_init.gdb\""
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
