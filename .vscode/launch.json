{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "lcad - local app debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/helloworld_c",
            "program": "${workspaceFolder}/build/helloworld_c/app",
            "MIMode": "gdb",
            "args": []
        },
        {
            "name": "tgad - target app debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default",
            "program": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default/app.elf",
            "preLaunchTask": "target app reset",
            "args": [],
            "environment": [],
            "externalConsole": false,
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "MIMode": "gdb",
            "targetArchitecture": "arm",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:2331",
            "miDebuggerArgs": "-q -x \"gdb_init.gdb\""
        },
        {
            "name": "tgadl - target app debug (load)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default",
            "program": "${workspaceFolder}/build/hello_world_netduinoplus2_qemu/build/Default/app.elf",
            "preLaunchTask": "target app load",
            "args": [],
            "environment": [],
            "externalConsole": false,
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "MIMode": "gdb",
            "targetArchitecture": "arm",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:2331",
            "miDebuggerArgs": "-q -x \"gdb_init.gdb\""
        },
        {
            "name": "pydcf - Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        },
        {
            "name": "rslad - rust local app debug",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=${workspaceFolder}/lib/rust_temp/app/rust_ex001_hello_world/Cargo.toml",
                    "--target-dir=${workspaceFolder}/build/rust_ex001_hello_world"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}/lib/rust_temp/app/rust_ex001_hello_world"
        }
    ]
}
