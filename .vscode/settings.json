{
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "terminal.integrated.suggest.enabled": false,
    "cmake.generator": "Unix Makefiles",
    "explorer.autoReveal": true,
    "editor.renderWhitespace": "all",
    "git.detectSubmodulesLimit": 120,
    "xml.format.splitAttributes": "preserve",
    "xml.format.joinContentLines": true,
    "xml.format.maxLineWidth": 10000,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/helloworld_c/compile_commands.json"
}
